// Generated/patched by `npx auth generate --config prisma/auth-cli/customer-auth.cli-config.ts
// --output prisma/schema/customer-auth.prisma`. Review diffs before accepting;
// avoid hand-editing fields Better Auth owns (the back-relation to Customer
// below is the one deliberate exception — Prisma requires it and the CLI
// doesn't know to add it).
model CustomerAccount {
  id                  String               @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  name                String
  email               String
  emailVerified       Boolean              @default(false)
  image               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  banned              Boolean?             @default(false)
  banReason           String?
  banExpires          DateTime?
  customersessions    CustomerSession[]
  customercredentials CustomerCredential[]
  customer            Customer?
  oauthclients        OauthClient[]
  oauthrefreshtokens  OauthRefreshToken[]
  oauthaccesstokens   OauthAccessToken[]
  oauthconsents       OauthConsent[]

  @@unique([email])
  @@map("CustomerAccount")
}

model CustomerSession {
  id                 String              @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  expiresAt          DateTime
  token              String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  ipAddress          String?
  userAgent          String?
  userId             String              @db.Uuid
  customeraccount    CustomerAccount     @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthrefreshtokens OauthRefreshToken[]
  oauthaccesstokens  OauthAccessToken[]

  @@unique([token])
  @@index([userId])
  @@map("CustomerSession")
}

model CustomerCredential {
  id                    String          @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  // Added by better-auth 1.7's account-identity change (scopes an account by
  // issuer rather than just provider config). Backfilled in the same
  // migration that adds this column — see that migration.sql's raw SQL and
  // the official backfill table in better-auth's 1.7 upgrade guide:
  // credential -> "local:credential", a provider with a known trusted issuer
  // -> that issuer URL, otherwise -> "local:oauth:<providerId>".
  issuer                String
  userId                String          @db.Uuid
  customeraccount       CustomerAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@unique([issuer, accountId], map: "CustomerCredential_issuer_accountId_uidx")
  @@index([userId])
  @@map("CustomerCredential")
}

model CustomerVerification {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("CustomerVerification")
}

// Everything below is added by the jwt()/mcp() plugins (customer-auth.factory.ts).
// Hand-integrated once (see the MCP/OAuth plan) because `npx auth generate` can't
// run against the real, DB-connected factory config until these tables already
// exist — the mcp() plugin eagerly upserts its configured `resource` row against
// OauthResource at construction time. Model/field shapes were produced by running
// `npx auth generate` against a schema-only config (jwt()+mcp() plugins, no real
// database adapter) and then renaming the generic User/Session relation targets
// to CustomerAccount/CustomerSession and applying this file's @db.Uuid convention
// to every id/userId/sessionId/refreshId field that relates to a real UUID column
// (clientId/resourceId/identifier stay plain String — they're business-level
// OAuth identifiers, not this schema's internal UUID primary keys). Once migrated,
// future `npx auth generate` runs against the real config work normally again.

model Jwks {
  id         String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

model OauthClient {
  id                               String                @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  clientId                         String
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?              @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]
  clientCredentialsScopes          String[]              @default([])
  userId                           String?               @db.Uuid
  customeraccount                  CustomerAccount?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                        DateTime?
  updatedAt                        DateTime?
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           String[]
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]
  responseTypes                    String[]
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?              @default(false)
  referenceId                      String?
  metadata                         Json?
  oauthclientresources             OauthClientResource[]
  oauthrefreshtokens               OauthRefreshToken[]
  oauthaccesstokens                OauthAccessToken[]
  oauthconsents                    OauthConsent[]

  @@unique([clientId])
  @@index([userId])
  @@map("oauthClient")
}

model OauthResource {
  id                            String                @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  identifier                    String
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?              @default(false)
  disabled                      Boolean?              @default(false)
  createdAt                     DateTime?
  updatedAt                     DateTime?
  policyVersion                 Int?                  @default(1)
  metadata                      Json?
  oauthclientresources          OauthClientResource[]

  @@unique([identifier])
  @@map("oauthResource")
}

model OauthClientResource {
  id            String        @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  clientId      String
  oauthclient   OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId    String
  oauthresource OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata      Json?
  createdAt     DateTime?

  @@unique([clientId, resourceId], map: "oauthClientResource_clientId_resourceId_uidx")
  @@index([clientId])
  @@index([resourceId])
  @@map("oauthClientResource")
}

model OauthRefreshToken {
  id                      String             @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  token                   String
  clientId                String
  oauthclient             OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?            @db.Uuid
  customersession         CustomerSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String             @db.Uuid
  customeraccount         CustomerAccount    @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  String[]
  oauthaccesstokens       OauthAccessToken[]

  @@unique([token])
  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauthRefreshToken")
}

model OauthAccessToken {
  id                      String             @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  token                   String
  clientId                String
  oauthclient             OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?            @db.Uuid
  customersession         CustomerSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?            @db.Uuid
  customeraccount         CustomerAccount?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  refreshId               String?            @db.Uuid
  oauthrefreshtoken       OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]

  @@unique([token])
  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauthAccessToken")
}

model OauthConsent {
  id                      String           @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  clientId                String
  oauthclient             OauthClient      @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?          @db.Uuid
  customeraccount         CustomerAccount? @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  resources               String[]
  requestedUserInfoClaims String[]
  scopes                  String[]
  createdAt               DateTime
  updatedAt               DateTime

  @@index([clientId])
  @@index([userId])
  @@map("oauthConsent")
}

model OauthClientAssertion {
  id        String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  expiresAt DateTime

  @@map("oauthClientAssertion")
}
