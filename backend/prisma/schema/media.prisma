enum MediaSource {
  MINIO

  @@map("MediaSource")
}

model Media {
  id           String      @id @db.Uuid
  source       MediaSource
  storageKey   String
  originalName String
  extension    String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  customer     Customer?

  smartCardTemplate     SmartCardTemplate?
  smartCardProfile      SmartCardProfile?
  smartCardFounder      SmartCardFounder?
  smartCardService      SmartCardService?
  smartCardGalleryImage SmartCardGalleryImage?

  ecardHeroProfilePhoto ECard?                  @relation("ECardHeroProfilePhoto")
  ecardHeroBanner       ECard?                  @relation("ECardHeroBanner")
  ecardGalleryImage     ECardGalleryImage?
  ecardBrochure         ECardBrochureComponent?

  organisation                              Organisation?
  organisationEcardTemplateHeroProfilePhoto OrganisationEcardTemplate?                  @relation("OrganisationEcardTemplateHeroProfilePhoto")
  organisationEcardTemplateHeroBanner       OrganisationEcardTemplate?                  @relation("OrganisationEcardTemplateHeroBanner")
  organisationEcardTemplateGalleryImage     OrganisationEcardTemplateGalleryImage?
  organisationEcardTemplateBrochure         OrganisationEcardTemplateBrochureComponent?

  productMedia ProductMedia?

  emailSignatureProfileImage EmailSignature? @relation("EmailSignatureProfileImage")
  emailSignatureCompanyLogo  EmailSignature? @relation("EmailSignatureCompanyLogo")
  emailSignatureBannerImage  EmailSignature? @relation("EmailSignatureBannerImage")

  @@map("Media")
}
