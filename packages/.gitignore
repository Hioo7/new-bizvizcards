# Workspace-wide ignores for packages/ (each package also has its own .gitignore)
node_modules/
dist/
build/
*.tsbuildinfo
*.log

# Expo / Metro
.expo/
.metro-health-check*
web-build/

# Storybook / design-sync / review artifacts
storybook-static/
.review/
.ds-sync/
ds-bundle/

# Native scaffolds (regenerated by expo prebuild)
/ui-native/example/ios/
/ui-native/example/android/

# Env / secrets
.env
.env.*
!.env.example
