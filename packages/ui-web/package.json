{
  "name": "@bizvizcards/ui",
  "version": "0.1.0",
  "description": "BizVizCards mobile-first UI primitives — the shared design foundation for the BizViz apps",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build:js": "tsup",
    "build:css": "tailwindcss -i ./theme.css -o ./dist/styles.css --minify",
    "build": "npm run build:js && npm run build:css",
    "typecheck": "tsc --noEmit",
    "gen:theme": "node scripts/gen-theme-css.mjs",
    "prebuild": "node scripts/gen-theme-css.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "daisyui": "^5.6.15",
    "lucide-react": "^1.23.0",
    "playwright": "^1.62.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2",
    "tsup": "^8.5.0",
    "typescript": "~6.0.2"
  },
  "dependencies": {
    "@bizvizcards/tokens": "file:../tokens"
  }
}
