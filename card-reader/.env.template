# Card Reader service configuration. Every key is optional — the defaults shown
# are production-safe. Copy to `.env` and override as needed.
# Env var names are the setting name upper-cased with a CARD_READER_ prefix.

# ── General ──────────────────────────────────────────────────────────────────
CARD_READER_ENVIRONMENT=prod          # dev | staging | prod
CARD_READER_LOG_LEVEL=INFO
CARD_READER_LOG_JSON=true              # false => human-readable console output

# ── CORS ─────────────────────────────────────────────────────────────────────
# Only relevant when a browser calls the service directly (dev). In prod it is
# same-origin behind nginx, so this is effectively unused. CSV or JSON list.
CARD_READER_ALLOWED_ORIGINS=http://localhost:5173

# ── Upload limits ────────────────────────────────────────────────────────────
CARD_READER_MAX_UPLOAD_BYTES=10485760   # 10 MiB — keep in sync with nginx client_max_body_size

# ── Worker model (read by gunicorn.conf.py) ──────────────────────────────────
CARD_READER_WORKERS=2
CARD_READER_WORKER_TIMEOUT=60           # gunicorn hard kill — must exceed PIPELINE_TIMEOUT_S
CARD_READER_GRACEFUL_TIMEOUT=30
CARD_READER_MAX_REQUESTS=200            # recycle a worker after this many requests
CARD_READER_MAX_REQUESTS_JITTER=50

# ── Concurrency / load shedding ──────────────────────────────────────────────
CARD_READER_OCR_MAX_CONCURRENCY=2       # concurrent OCR jobs per worker
CARD_READER_OCR_MAX_QUEUE=4             # extra requests allowed to wait for a slot
CARD_READER_OCR_QUEUE_TIMEOUT_S=10      # wait longer than this for a slot => 503
CARD_READER_TESSERACT_TIMEOUT_S=20      # kill the tesseract subprocess after this
CARD_READER_PIPELINE_TIMEOUT_S=30      # whole-request wall clock => 504

# ── Pipeline tuning ──────────────────────────────────────────────────────────
CARD_READER_TESSERACT_CMD=tesseract
CARD_READER_TESSERACT_CONFIG=--oem 3 --psm 4
CARD_READER_TESSERACT_LANG=eng
CARD_READER_MIN_WORD_CONFIDENCE=0.5
CARD_READER_IMAGE_UPSCALE_PX=1500
CARD_READER_ENABLE_DESKEW=true
CARD_READER_SPACY_MODEL=en_core_web_sm
CARD_READER_DEFAULT_PHONE_REGION=US
